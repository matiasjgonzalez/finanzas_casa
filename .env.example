# Copiá este archivo como .env (en la raíz del proyecto) y completá los valores.
# El archivo .env está en .gitignore: nunca lo subas al repositorio.

# --- Entorno ---
# development | test | production
# "production" exige HTTPS: las cookies de sesión solo viajan cifradas y se activa HSTS.
# Para usar la app en tu casa (http://localhost o http://IP-de-la-PC:8000) dejá "development":
# con "production" sin HTTPS no se podría iniciar sesión.
APP_ENV=development

# --- PostgreSQL ---
# URL que usa el backend (driver psycopg 3): usuario:contraseña@servidor:puerto/base
# Si la contraseña tiene caracteres especiales (@ : / # %), codificalos en formato URL.
DATABASE_URL=postgresql+psycopg://family_finance:cambiar-por-una-contraseña-larga@localhost:5432/family_finance

# Base exclusiva para las pruebas automáticas. Su nombre DEBE terminar en "_test":
# las pruebas la vacían y la recrean en cada ejecución.
TEST_DATABASE_URL=postgresql+psycopg://family_finance:cambiar-por-una-contraseña-larga@localhost:5432/family_finance_test

# --- API ---
# Orígenes autorizados para CORS, separados por comas (la URL del frontend).
CORS_ORIGINS=http://localhost:5173

# --- Comprobantes ---
# Directorio privado donde se guardan los archivos (fuera del frontend público).
STORAGE_DIR=./storage
# Tamaño máximo por archivo, en MB.
MAX_UPLOAD_MB=10

# --- Copias de seguridad (python -m app.backup, respaldo.cmd) ---
# Carpeta donde se guardan (relativa al proyecto o absoluta). Conviene copiar esa carpeta
# también a otro disco, un pendrive o la nube: una copia en la misma PC no protege si se rompe.
BACKUP_DIR=./respaldos
# Cuántas copias se conservan (se hace una por día al iniciar la aplicación).
BACKUP_KEEP=30

# --- Servidor (Railway): ya vienen configuradas en el Dockerfile o se cargan en Railway ---
# TRUST_PROXY=true          la IP real de cada persona viene del proxy (solo detrás de uno)
# SUPERADMIN_USERNAME=admin superadmin que se crea en el primer despliegue…
# SUPERADMIN_PASSWORD=      …con esta contraseña (mínimo 12). Borrarla después de entrar.

# --- Sesiones e inicio de sesión (opcional; estos son los valores por defecto) ---
# SESSION_DAYS=14
# LOGIN_MAX_FAILURES_PER_USERNAME=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
